<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 2F-B3: 実案件相当の総合試験。製品本体からは参照しない
    (ExcelBatchTool.sln にも含めない)。

    測るのは製品と同じ経路そのもの — OcrPack.Load で Offline OCR Pack を読み、
    PdfScanReader に通し、確認画面へ出るのと同じ結果を数え、
    PdfReader.Execute で実際に .xlsx を作って読み直す。

    使い方:
      dotnet run -c Release, 続けて引数:
        <packDir> [workDir] [A|B|C|D|E|F]
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NoWarn>CA1416;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ExcelBatchTool.Core\ExcelBatchTool.Core.csproj" />
  </ItemGroup>

</Project>
