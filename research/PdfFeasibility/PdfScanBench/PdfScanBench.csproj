<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 2F-B2: 傾き補正 / スキャン表 / 定型帳票 / 印 を、Ground Truth との
    完全一致率と「誤って自動確定した件数」で測るためのベンチマーク。
    製品本体からは参照しない(ExcelBatchTool.sln にも含めない)。

    測るのは製品と同じ経路そのもの — OcrPack.Load で Offline OCR Pack を読み、
    PdfScanReader に通し、確認画面へ出るのと同じ結果を数える。
    ベンチ専用の近道を作ると、測った数値が製品の挙動と一致しなくなるため。

    使い方:
      dotnet run -c Release, 続けて引数:
        <packDir> [workDir] [deskew|table|form|mark]
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NoWarn>CA1416;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- fixture(傾き・罫線・帳票・印)の描画にだけ使う。製品側では使わない。 -->
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ExcelBatchTool.Core\ExcelBatchTool.Core.csproj" />
  </ItemGroup>

</Project>
