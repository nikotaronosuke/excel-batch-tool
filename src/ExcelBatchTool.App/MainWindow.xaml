<Window x:Class="ExcelBatchTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExcelBatchTool.App.ViewModels"
        Title="Excel Batch Tool - Workbook 安全解析(開発版)"
        Width="1100" Height="720" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Background="#F4F5F7">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#3B4252" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

        <Style x:Key="LevelGlyphText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LevelGlyph}" Value="✅">
                    <Setter Property="Foreground" Value="#1F8A4C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelGlyph}" Value="⚠">
                    <Setter Property="Foreground" Value="#B95E04" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelGlyph}" Value="✖">
                    <Setter Property="Foreground" Value="#C0392B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelGlyph}" Value="…">
                    <Setter Property="Foreground" Value="#8A8F98" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MergeIssueGlyphText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Glyph}" Value="⚠">
                    <Setter Property="Foreground" Value="#B95E04" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Glyph}" Value="✖">
                    <Setter Property="Foreground" Value="#C0392B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryChip" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D8DCE3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="#2B579A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#24497F" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#A9B4C4" />
                    <Setter Property="BorderBrush" Value="#A9B4C4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- タブ 4〜6 の上に置く「処理設定(レシピ)」の共通領域。 -->
        <DataTemplate x:Key="RecipeAreaTemplate">
            <Border Background="#FFFFFF" BorderBrush="#D8DCE3" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="110" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="80" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="処理設定" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#3B4252" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" Height="24" FontSize="12"
                                  VerticalContentAlignment="Center"
                                  ToolTip="このタブで使える、保存済みの設定"
                                  ItemsSource="{Binding Recipes}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}" />
                        <Button Grid.Column="2" Content="読み込む" Padding="10,3" FontSize="11"
                                Margin="6,0,0,0" Command="{Binding LoadCommand}" />
                        <Button Grid.Column="3" Content="更新" Padding="10,3" FontSize="11"
                                Margin="4,0,0,0"
                                ToolTip="選んだ設定の内容を、今の設定で置き換えます"
                                Command="{Binding UpdateCommand}" />
                        <Button Grid.Column="4" Content="削除" Padding="10,3" FontSize="11"
                                Margin="4,0,0,0" Command="{Binding DeleteCommand}" />
                        <TextBlock Grid.Column="5" Text="名前" FontSize="12" Foreground="#5B6472"
                                   VerticalAlignment="Center" Margin="14,0,6,0" />
                        <TextBox Grid.Column="6" Height="24" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 ToolTip="例: 商品マスタ月次更新(60 文字以内)"
                                 Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="7" Content="現在の設定を保存" Padding="10,3" FontSize="11"
                                Margin="6,0,0,0" Command="{Binding SaveCommand}" />
                    </Grid>

                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#8A8F98" Margin="0,6,0,0"
                               Text="よく使う設定をこの PC に保存して、次回そのまま読み込めます。ファイルそのものは保存しないので、毎回そのときのファイルを選んでください。読み込んでも自動では実行しません。" />

                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                               Text="{Binding MessageText}"
                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1F8A4C" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMessageError}" Value="True">
                                        <Setter Property="Foreground" Value="#B95E04" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- 追加エリア -->
        <Border DockPanel.Dock="Top"
                Background="#FAFBFD" BorderBrush="#B9C2D0" BorderThickness="1"
                CornerRadius="6" Padding="12" MinHeight="96">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Excel ファイル (.xlsx) をここにドロップ"
                           FontSize="14" Foreground="#3B4252" HorizontalAlignment="Center" />
                <TextBlock Text="または" FontSize="11" Foreground="#8A8F98"
                           HorizontalAlignment="Center" Margin="0,4" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="ファイルを選択" Style="{StaticResource ActionButton}"
                            Command="{Binding SelectFilesCommand}" />
                    <Button Content="一覧をクリア" Margin="8,0,0,0" Padding="14,7"
                            Command="{Binding ClearCommand}" />
                </StackPanel>
                <TextBlock Text="解析は読み取り専用です。対象ファイルは変更しません。"
                           FontSize="11" Foreground="#8A8F98"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 集計 -->
        <Border DockPanel.Dock="Top" Margin="0,12,0,0"
                Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#2E3440"
                           VerticalAlignment="Center" Text="{Binding SummaryText}" />
                <TextBlock FontSize="13" Foreground="#5B6472" VerticalAlignment="Center"
                           Margin="12,0,16,0"
                           Text="{Binding TotalSheetCount, StringFormat={}{0} シート}" />
                <Border Style="{StaticResource SummaryChip}">
                    <TextBlock Foreground="#1F8A4C" FontSize="12"
                               Text="{Binding NormalCount, StringFormat=✅ 通常  {0}}" />
                </Border>
                <Border Style="{StaticResource SummaryChip}">
                    <TextBlock Foreground="#B95E04" FontSize="12"
                               Text="{Binding AttentionCount, StringFormat=⚠ 注意が必要  {0}}" />
                </Border>
                <Border Style="{StaticResource SummaryChip}">
                    <TextBlock Foreground="#C0392B" FontSize="12"
                               Text="{Binding UnsupportedCount, StringFormat=✖ 現在非対応  {0}}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                Background="#FFFFFF" BorderBrush="#D8DCE3" BorderThickness="1"
                CornerRadius="4" Padding="10,6">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="140" Height="10"
                             IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}" />
                <TextBlock FontSize="12" Foreground="#5B6472" VerticalAlignment="Center"
                           Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- メイン: 手順ごとのタブ -->
        <TabControl Margin="0,12,0,0" Background="Transparent" BorderThickness="0" Padding="0">

        <TabItem Header="1. 解析結果">
        <!-- ファイル一覧 + 詳細 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*" MinWidth="440" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="8*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- ファイル一覧 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DCE3"
                    BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ファイル一覧"
                               FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                               Margin="12,10,12,6" />
                    <ListView BorderThickness="0" Margin="4,0,4,4"
                              ItemsSource="{Binding Files}"
                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="状態" Width="96">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource LevelGlyphText}"
                                                           Text="{Binding LevelGlyph}" Margin="0,0,6,0" />
                                                <TextBlock FontSize="12" VerticalAlignment="Center"
                                                           Text="{Binding LevelDisplay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ファイル名" Width="168">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Text="{Binding FileName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="シート数" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Text="{Binding SheetCountDisplay}"
                                                       HorizontalAlignment="Right" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="サイズ" Width="64">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Text="{Binding FileSizeDisplay}"
                                                       HorizontalAlignment="Right" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="解析" Width="48">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Text="{Binding StatusDisplay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- 詳細 -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D8DCE3"
                    BorderThickness="1" CornerRadius="4" Padding="14">
                <Grid>
                    <TextBlock Text="左の一覧からファイルを選択すると、シート情報と安全性チェック詳細を表示します。"
                               FontSize="12" Foreground="#8A8F98"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedFile}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LevelGlyphText}" FontSize="16"
                                           Text="{Binding LevelGlyph}" Margin="0,0,8,0" />
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#2E3440"
                                           Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="#8A8F98" Margin="0,4,0,0"
                                       Text="{Binding FilePath}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock FontSize="12" Foreground="#5B6472"
                                           Text="{Binding LevelDisplay, StringFormat=分類: {0}}" Margin="0,0,16,0" />
                                <TextBlock FontSize="12" Foreground="#5B6472"
                                           Text="{Binding FileSizeDisplay, StringFormat=サイズ: {0}}" Margin="0,0,16,0" />
                                <TextBlock FontSize="12" Foreground="#5B6472"
                                           Text="{Binding SheetCountDisplay, StringFormat=シート数: {0}}" />
                            </StackPanel>

                            <Border Background="#FDF2F1" BorderBrush="#E4B6B1" BorderThickness="1"
                                    CornerRadius="4" Padding="10,8" Margin="0,10,0,0"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="12" Foreground="#A93226" TextWrapping="Wrap"
                                           Text="{Binding ErrorMessage}" />
                            </Border>

                            <TextBlock Text="シート情報" Style="{StaticResource SectionTitle}" />
                            <Border BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <Border Background="#F1F3F6" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="シート名" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#5B6472" />
                                            <TextBlock Grid.Column="1" Text="種類" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#5B6472" />
                                            <TextBlock Grid.Column="2" Text="使用範囲(概算)" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#5B6472" />
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Sheets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10,5" BorderBrush="#EEF0F3" BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="12" Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#5B6472"
                                                                   Text="{Binding KindDisplay}" />
                                                        <TextBlock Grid.Column="2" FontSize="12" Foreground="#5B6472"
                                                                   Text="{Binding RangeDisplay}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="安全性チェック詳細" Style="{StaticResource SectionTitle}" />
                            <TextBlock FontSize="12" Foreground="#1F8A4C"
                                       Text="✅ 書き換え時に注意が必要な要素は検出されませんでした。"
                                       Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Findings}"
                                          Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FBFCFD" BorderBrush="#E2E5EA" BorderThickness="1"
                                                CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource LevelGlyphText}"
                                                               Text="{Binding Glyph}" Margin="0,0,6,0" />
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#2E3440"
                                                               Text="{Binding DisplayName}" Margin="0,0,8,0" />
                                                    <TextBlock FontSize="12" Foreground="#5B6472"
                                                               Text="{Binding CountDisplay}" />
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="#8A8F98" Margin="19,3,0,0"
                                                           Text="{Binding SheetsDisplay}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SheetsDisplay}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#5B6472" Margin="19,3,0,0"
                                                           Text="{Binding Description}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        </TabItem>

        <TabItem Header="2. 表をまとめる">
            <Grid Margin="0,12,0,0" DataContext="{Binding Merge}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*" MinWidth="420" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="8*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- 対象シートの選択 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="統合するシートを選ぶ"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="12,10,12,2" />
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="1 ファイルにつき 1 シートを選びます。表の 1 行目を見出しとして扱います。入力ファイルは変更しません。"
                                   FontSize="11" Foreground="#8A8F98" Margin="12,0,12,6" />
                        <Border DockPanel.Dock="Top" Background="#F1F5FA" BorderBrush="#C9D6E6"
                                BorderThickness="1" CornerRadius="4" Margin="12,0,12,8" Padding="9,6">
                            <TextBlock FontSize="11" Foreground="#3B4252" TextWrapping="Wrap"
                                       Text="「基準」に選んだシートの見出し順で、統合結果の列を並べます。" />
                        </Border>

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <StackPanel>
                                <CheckBox Content="先頭に「元ファイル」列を追加する" FontSize="12"
                                          IsChecked="{Binding IncludeSourceFileColumn, Mode=TwoWay}" />
                                <CheckBox Content="先頭に「元シート」列を追加する" FontSize="12" Margin="0,6,0,0"
                                          IsChecked="{Binding IncludeSourceSheetColumn, Mode=TwoWay}" />
                                <Button Content="プレビューを更新" Margin="0,10,0,0" Padding="14,7"
                                        HorizontalAlignment="Left"
                                        Command="{Binding RefreshPreviewCommand}" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <TextBlock Text="「1. 解析結果」タブで Excel ファイルを追加すると、ここに統合できるシートが表示されます。"
                                       FontSize="12" Foreground="#8A8F98" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="300" Margin="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSources}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,0"
                                          Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Sources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="4,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                                              IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanInclude}" />
                                                    <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                                               Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FilePath}" />
                                                    <ComboBox Grid.Column="2" FontSize="12" Height="24" Margin="6,0,0,0"
                                                              ItemsSource="{Binding SheetNames}"
                                                              SelectedItem="{Binding SelectedSheetName, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanInclude}" />
                                                    <RadioButton Grid.Column="3" Content="基準" FontSize="12"
                                                                 GroupName="MergeBaseSheet" Margin="10,0,2,0"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip="このシートの見出し順で統合結果の列を並べます"
                                                                 IsChecked="{Binding IsBase, Mode=TwoWay}"
                                                                 IsEnabled="{Binding IsSelectableAsBase}" />

                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                               FontSize="11" Foreground="#C0392B" TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               Text="{Binding UnavailableReason}"
                                                               Visibility="{Binding HasUnavailableReason, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 統合プレビュー -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="統合プレビュー"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="14,10,14,6" />

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="14,10">
                            <StackPanel>
                                <Button Content="統合ファイルを作成" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding CreateCommand}" />
                                <TextBlock FontSize="11" Foreground="#8A8F98" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="新しい .xlsx を作成します。既存ファイルは上書きしません。" />
                                <Border Background="#F1F7F2" BorderBrush="#BFD9C4" BorderThickness="1"
                                        CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="#1F6B3A" TextWrapping="Wrap"
                                                   Text="{Binding ResultText}" />
                                        <TextBlock FontSize="11" Foreground="#5B6472" Margin="0,3,0,0"
                                                   Text="{Binding ResultPath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ResultPath}"
                                                   Visibility="{Binding HasResultPath, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,0,14,0">
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="#5B6472" TextWrapping="Wrap"
                                           Text="{Binding StatusText}" />

                                <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#F7F8FA" BorderBrush="#E2E5EA" BorderThickness="1"
                                            CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="対象" Width="42" FontSize="11" Foreground="#8A8F98" />
                                                <TextBlock FontSize="12" Foreground="#2E3440"
                                                           Text="{Binding TargetSummaryText}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="基準" Width="42" FontSize="11" Foreground="#8A8F98" />
                                                <TextBlock FontSize="12" Foreground="#2E3440" TextWrapping="Wrap"
                                                           Text="{Binding PreviewBaseText}"
                                                           ToolTip="このシートの見出し順で列を並べています" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="予定" Width="42" FontSize="11" Foreground="#8A8F98" />
                                                <TextBlock FontSize="12" Foreground="#2E3440" TextWrapping="Wrap"
                                                           Text="{Binding PlannedRowsText}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="確認" Width="42" FontSize="11" Foreground="#8A8F98" />
                                                <TextBlock FontSize="12" Foreground="#2E3440"
                                                           Text="{Binding IssueSummaryText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="出力する列" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding OutputHeaders}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1F3F6" BorderBrush="#D8DCE3" BorderThickness="1"
                                                        CornerRadius="3" Padding="8,3" Margin="0,0,6,6">
                                                    <TextBlock FontSize="12" Foreground="#3B4252" Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="確認事項" Style="{StaticResource SectionTitle}" />

                                    <TextBlock FontSize="12" Foreground="#1F8A4C"
                                               Text="✅ 実行を妨げる問題はありません。"
                                               Visibility="{Binding HasNoIssues, Converter={StaticResource BoolToVis}}" />

                                    <ItemsControl ItemsSource="{Binding Issues}"
                                                  Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FBFCFD" BorderBrush="#E2E5EA" BorderThickness="1"
                                                        CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource MergeIssueGlyphText}"
                                                                       Text="{Binding Glyph}" Margin="0,0,6,0" />
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#2E3440" Text="{Binding Location}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock FontSize="11" Foreground="#5B6472" Margin="19,3,0,0"
                                                                   Text="{Binding Message}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="3. シートをまとめる">
            <Grid Margin="0,12,0,0" DataContext="{Binding Aggregation}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*" MinWidth="420" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="8*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- シートの選択 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="まとめるシートを選ぶ"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="12,10,12,2" />
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="選んだシートを、新しい 1 つのブックにシートとして並べます。行データは混ぜません。入力ファイルは変更しません。"
                                   FontSize="11" Foreground="#8A8F98" Margin="12,0,12,8" />

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="#8A8F98" TextWrapping="Wrap"
                                           Text="出力シート名は編集できます。31 文字まで、: \ / ? * [ ] は使えません。" />
                                <Button Content="プレビューを更新" Margin="0,8,0,0" Padding="14,7"
                                        HorizontalAlignment="Left"
                                        Command="{Binding RefreshPreviewCommand}" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <TextBlock Text="「1. 解析結果」タブで Excel ファイルを追加すると、ここにシートが表示されます。"
                                       FontSize="12" Foreground="#8A8F98" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="300" Margin="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasWorkbooks}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,0"
                                          Visibility="{Binding HasWorkbooks, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Workbooks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <Border Background="#F1F3F6" Padding="8,5" CornerRadius="3">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#3B4252"
                                                               Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FilePath}" />
                                                </Border>

                                                <TextBlock FontSize="11" Foreground="#C0392B" TextWrapping="Wrap"
                                                           Margin="8,4,0,0" Text="{Binding UnavailableReason}"
                                                           Visibility="{Binding HasUnavailableReason, Converter={StaticResource BoolToVis}}" />

                                                <ItemsControl ItemsSource="{Binding Sheets}" Margin="8,2,0,0"
                                                              Visibility="{Binding CanSelect, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" MinWidth="80" />
                                                                    <ColumnDefinition Width="150" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                                          Margin="0,0,6,0"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                                <TextBlock Grid.Column="1" FontSize="12"
                                                                           VerticalAlignment="Center"
                                                                           Text="{Binding DisplayName}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding DisplayName}" />
                                                                <TextBox Grid.Column="2" FontSize="12" Height="24"
                                                                         VerticalContentAlignment="Center"
                                                                         ToolTip="出力シート名"
                                                                         IsEnabled="{Binding IsSelected}"
                                                                         Text="{Binding OutputName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 集約プレビュー -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="集約プレビュー"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="14,10,14,6" />

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="14,10">
                            <StackPanel>
                                <Button Content="ブックを作成" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding CreateCommand}" />
                                <TextBlock FontSize="11" Foreground="#8A8F98" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="新しい .xlsx を作成します。既存ファイルは上書きしません。" />
                                <Border Background="#F1F7F2" BorderBrush="#BFD9C4" BorderThickness="1"
                                        CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="#1F6B3A" TextWrapping="Wrap"
                                                   Text="{Binding ResultText}" />
                                        <TextBlock FontSize="11" Foreground="#5B6472" Margin="0,3,0,0"
                                                   Text="{Binding ResultPath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ResultPath}"
                                                   Visibility="{Binding HasResultPath, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,0,14,0">
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="#5B6472" TextWrapping="Wrap"
                                           Text="{Binding StatusText}" />

                                <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#F7F8FA" BorderBrush="#E2E5EA" BorderThickness="1"
                                            CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="対象" Width="42" FontSize="11" Foreground="#8A8F98" />
                                                <TextBlock FontSize="12" Foreground="#2E3440"
                                                           Text="{Binding TargetSummaryText}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="出力" Width="42" FontSize="11" Foreground="#8A8F98" />
                                                <TextBlock FontSize="12" Foreground="#2E3440" TextWrapping="Wrap"
                                                           Text="{Binding PlannedSheetsText}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="確認" Width="42" FontSize="11" Foreground="#8A8F98" />
                                                <TextBlock FontSize="12" Foreground="#2E3440"
                                                           Text="{Binding IssueSummaryText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 実行可否に直結するため、シート一覧より先に確認事項を出す。 -->
                                    <TextBlock Text="確認事項" Style="{StaticResource SectionTitle}" />

                                    <TextBlock FontSize="12" Foreground="#1F8A4C"
                                               Text="✅ 実行を妨げる問題はありません。"
                                               Visibility="{Binding HasNoIssues, Converter={StaticResource BoolToVis}}" />

                                    <ItemsControl ItemsSource="{Binding Issues}"
                                                  Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FBFCFD" BorderBrush="#E2E5EA" BorderThickness="1"
                                                        CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource MergeIssueGlyphText}"
                                                                       Text="{Binding Glyph}" Margin="0,0,6,0" />
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#2E3440" Text="{Binding Location}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock FontSize="11" Foreground="#5B6472" Margin="19,3,0,0"
                                                                   Text="{Binding Message}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="出力するシートの順序" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding OrderedSheets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="12" Foreground="#8A8F98"
                                                               Text="{Binding Order, StringFormat={}{0}.}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontSize="12" Foreground="#2E3440"
                                                                   Text="{Binding OutputSheetName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="11" Foreground="#8A8F98"
                                                                   Text="{Binding SourceDisplay, StringFormat=← {0}}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding SourceDisplay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="4. セルをまとめて変更">
            <DockPanel Margin="0,12,0,0" DataContext="{Binding Mutation}">
            <ContentControl DockPanel.Dock="Top" Content="{Binding Recipes}"
                            ContentTemplate="{StaticResource RecipeAreaTemplate}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*" MinWidth="420" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="8*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- 対象と新しい値の指定 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="変更するシートと値を指定する"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="12,10,12,2" />
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="選んだシートの同じセルへ、同じ値をまとめて入力します。元のファイルは変更せず、同じフォルダーに別名で保存します。"
                                   FontSize="11" Foreground="#8A8F98" Margin="12,0,12,8" />

                        <!-- 指定欄。下に固定して、シート一覧が伸び縮みするようにする。 -->
                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="変更するセル一覧" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#3B4252" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="行を追加" Padding="10,3" FontSize="11"
                                                Command="{Binding AddOperationCommand}" />
                                        <Button Content="選択行を削除" Padding="10,3" FontSize="11" Margin="6,0,0,0"
                                                Command="{Binding RemoveOperationCommand}" />
                                        <Button Content="表から貼り付け" Padding="10,3" FontSize="11" Margin="6,0,0,0"
                                                ToolTip="表計算でコピーした「セル・種類(文字/数値/空欄)・値」のタブ区切り 3 列を追加します"
                                                Command="{Binding PasteOperationsCommand}" />
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding Operations}"
                                          SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                                          Height="132" Margin="0,6,0,0"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" CanUserResizeRows="False"
                                          CanUserSortColumns="False" CanUserReorderColumns="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E9EBEF" BorderBrush="#D8DCE3"
                                          Background="White" RowBackground="White" RowHeight="27"
                                          FontSize="12" SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <!-- セル内の入力欄へフォーカスした行を削除対象として選択する。 -->
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="IsSelected" Value="True" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="セル" Width="64">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox FontSize="12" BorderThickness="0" Background="Transparent"
                                                             VerticalContentAlignment="Center" Margin="2,0"
                                                             ToolTip="変更するセルの位置(例: B2)"
                                                             Text="{Binding CellReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="種類" Width="72">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox FontSize="12" Margin="2,1"
                                                              VerticalContentAlignment="Center"
                                                              ItemsSource="{x:Static vm:MutationOperationViewModel.KindOptions}"
                                                              SelectedItem="{Binding KindDisplay, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="新しい値" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox FontSize="12" BorderThickness="0" Background="Transparent"
                                                             VerticalContentAlignment="Center" Margin="2,0"
                                                             IsEnabled="{Binding IsValueEnabled}"
                                                             Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="出力名" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" Height="24" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             ToolTip="元のファイル名の後ろに付ける文字"
                                             Text="{Binding OutputSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="プレビューを更新" Margin="10,0,0,0" Padding="14,5"
                                            Command="{Binding RefreshPreviewCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <TextBlock Text="「1. 解析結果」タブで Excel ファイルを追加すると、ここにシートが表示されます。"
                                       FontSize="12" Foreground="#8A8F98" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="300" Margin="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasWorkbooks}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,0"
                                          Visibility="{Binding HasWorkbooks, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Workbooks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <Border Background="#F1F3F6" Padding="8,5" CornerRadius="3">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#3B4252"
                                                               Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FilePath}" />
                                                </Border>

                                                <TextBlock FontSize="11" Foreground="#C0392B" TextWrapping="Wrap"
                                                           Margin="8,4,0,0" Text="{Binding UnavailableReason}"
                                                           Visibility="{Binding HasUnavailableReason, Converter={StaticResource BoolToVis}}" />

                                                <ItemsControl ItemsSource="{Binding Sheets}" Margin="8,2,0,0"
                                                              Visibility="{Binding CanSelect, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Margin="0,3,0,3" FontSize="12"
                                                                      VerticalContentAlignment="Center"
                                                                      Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 変更プレビュー -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="変更プレビュー"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="14,10,14,6" />

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="14,10">
                            <StackPanel>
                                <Button Content="変更したファイルを作成" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ExecuteCommand}" />
                                <TextBlock FontSize="11" Foreground="#8A8F98" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="元のファイルと同じフォルダーに、別名の .xlsx を作成します。元のファイルと既存ファイルは変更しません。" />
                                <!-- 失敗の内容を成功と同じ見た目で出さない。 -->
                                <Border BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FDF2F2" />
                                            <Setter Property="BorderBrush" Value="#E5C0C0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastRunSucceeded}" Value="True">
                                                    <Setter Property="Background" Value="#F1F7F2" />
                                                    <Setter Property="BorderBrush" Value="#BFD9C4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding ResultText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#A03030" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastRunSucceeded}" Value="True">
                                                        <Setter Property="Foreground" Value="#1F6B3A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,0,14,0">
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="#5B6472" TextWrapping="Wrap"
                                           Text="{Binding StatusText}" />

                                <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#F7F8FA" BorderBrush="#E2E5EA" BorderThickness="1"
                                            CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="対象" Width="42" FontSize="11" Foreground="#8A8F98" />
                                                <TextBlock FontSize="12" Foreground="#2E3440"
                                                           Text="{Binding TargetSummaryText}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="出力" Width="42" FontSize="11" Foreground="#8A8F98" />
                                                <TextBlock FontSize="12" Foreground="#2E3440" TextWrapping="Wrap"
                                                           Text="{Binding PlannedChangesText}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="確認" Width="42" FontSize="11" Foreground="#8A8F98" />
                                                <TextBlock FontSize="12" Foreground="#2E3440"
                                                           Text="{Binding IssueSummaryText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="確認事項" Style="{StaticResource SectionTitle}" />

                                    <TextBlock FontSize="12" Foreground="#1F8A4C"
                                               Text="✅ 実行を妨げる問題はありません。"
                                               Visibility="{Binding HasNoIssues, Converter={StaticResource BoolToVis}}" />

                                    <ItemsControl ItemsSource="{Binding Issues}"
                                                  Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FBFCFD" BorderBrush="#E2E5EA" BorderThickness="1"
                                                        CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource MergeIssueGlyphText}"
                                                                       Text="{Binding Glyph}" Margin="0,0,6,0" />
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#2E3440" Text="{Binding Location}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock FontSize="11" Foreground="#5B6472" Margin="19,3,0,0"
                                                                   Text="{Binding Message}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="変更内容" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding Targets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FBFCFD" BorderBrush="#E2E5EA" BorderThickness="1"
                                                        CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource MergeIssueGlyphText}"
                                                                       Text="{Binding Glyph}" Margin="0,0,6,0" />
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#2E3440"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding FileName}" />
                                                            <TextBlock FontSize="12" Foreground="#5B6472"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding SheetName, StringFormat= / {0}}" />
                                                            <TextBlock FontSize="12" Foreground="#5B6472"
                                                                       Text="{Binding CellReference, StringFormat= / {0}}" />
                                                        </StackPanel>
                                                        <TextBlock FontSize="11" Foreground="#5B6472" Margin="19,3,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding CurrentValueDisplay, StringFormat=現在: {0}}" />
                                                        <TextBlock FontSize="11" Foreground="#5B6472" Margin="19,1,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding NewValueDisplay, StringFormat=変更後: {0}}" />
                                                        <TextBlock FontSize="11" Foreground="#8A8F98" Margin="19,1,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding OutputFileName, StringFormat=出力: {0}}" />
                                                        <TextBlock FontSize="11" Foreground="#5B6472" Margin="19,3,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding StatusText}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            </DockPanel>
        </TabItem>

        <TabItem Header="5. 表から転記">
            <DockPanel Margin="0,12,0,0" DataContext="{Binding Mapping}">
            <ContentControl DockPanel.Dock="Top" Content="{Binding Recipes}"
                            ContentTemplate="{StaticResource RecipeAreaTemplate}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*" MinWidth="440" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="7*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- データ元と対応付け -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="データ元と対応付けを指定する"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="12,10,12,2" />
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="表からキーが一致する行を探し、その項目を転記先の決まったセルへ入れます。元のファイルは変更せず、同じフォルダーに別名で保存します。"
                                   FontSize="11" Foreground="#8A8F98" Margin="12,0,12,8" />

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="出力名" FontSize="12" Foreground="#5B6472"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Height="24" FontSize="12"
                                         VerticalContentAlignment="Center"
                                         ToolTip="元のファイル名の後ろに付ける文字"
                                         Text="{Binding OutputSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="プレビューを更新" Margin="10,0,0,0" Padding="14,5"
                                        Command="{Binding RefreshPreviewCommand}" />
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,0,12,0">
                            <StackPanel>
                                <!-- A. データ元 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="80" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="データ元を選ぶ" Padding="10,4" FontSize="12"
                                            Command="{Binding SelectSourceCommand}" />
                                    <TextBlock Grid.Column="1" FontSize="12" Foreground="#2E3440"
                                               VerticalAlignment="Center" Margin="8,0,8,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding SourceFileNameDisplay}" />
                                    <Button Grid.Column="2" Content="項目を読み込む" Padding="10,4" FontSize="12"
                                            Command="{Binding LoadColumnsCommand}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="70" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="シート" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1" Height="24" FontSize="12"
                                              IsEnabled="{Binding IsSheetSelectionEnabled}"
                                              ItemsSource="{Binding SourceSheetNames}"
                                              SelectedItem="{Binding SourceSheetName, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="項目名の行" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="12,0,6,0" />
                                    <TextBox Grid.Column="3" Height="24" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding HeaderRowText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <TextBlock FontSize="11" Foreground="#5B6472" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="{Binding SourceInfoText}"
                                           Visibility="{Binding HasSourceInfo, Converter={StaticResource BoolToVis}}" />

                                <!-- B. 照合 -->
                                <TextBlock Text="キーで対応付ける" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="80" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="データ元のキー" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1" Height="24" FontSize="12"
                                              ItemsSource="{Binding SourceColumns}"
                                              SelectedItem="{Binding KeyColumn, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="転記先のキー" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="12,0,6,0" />
                                    <TextBox Grid.Column="3" Height="24" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             ToolTip="転記先シートで、キーが入っているセル(例: A1)"
                                             Text="{Binding TargetKeyCell, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock FontSize="11" Foreground="#8A8F98" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="キーは文字として完全に一致するものだけを対応付けます(大文字小文字・前後の空白も区別します)。" />

                                <!-- C. 対応付け -->
                                <DockPanel Margin="0,14,0,0">
                                    <TextBlock Text="転記する項目" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#3B4252" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="行を追加" Padding="10,3" FontSize="11"
                                                Command="{Binding AddMappingCommand}" />
                                        <Button Content="選択行を削除" Padding="10,3" FontSize="11" Margin="6,0,0,0"
                                                Command="{Binding RemoveMappingCommand}" />
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding Mappings}"
                                          SelectedItem="{Binding SelectedMapping, Mode=TwoWay}"
                                          Height="120" Margin="0,6,0,0"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" CanUserResizeRows="False"
                                          CanUserSortColumns="False" CanUserReorderColumns="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E9EBEF" BorderBrush="#D8DCE3"
                                          Background="White" RowBackground="White" RowHeight="27"
                                          FontSize="12" SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="IsSelected" Value="True" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="データ元の項目" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox FontSize="12" Margin="2,1"
                                                              VerticalContentAlignment="Center"
                                                              ItemsSource="{Binding AvailableColumns}"
                                                              SelectedItem="{Binding SourceColumn, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="転記先セル" Width="86">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox FontSize="12" BorderThickness="0"
                                                             Background="Transparent" Margin="2,0"
                                                             VerticalContentAlignment="Center"
                                                             ToolTip="転記先のセル(例: D5)"
                                                             Text="{Binding TargetCell, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="種類" Width="72">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox FontSize="12" Margin="2,1"
                                                              VerticalContentAlignment="Center"
                                                              ItemsSource="{x:Static vm:SourceMappingRowViewModel.KindOptions}"
                                                              SelectedItem="{Binding KindDisplay, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- D. 転記先 -->
                                <TextBlock Text="転記先のシート" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="「1. 解析結果」タブで Excel ファイルを追加すると、ここに表示されます。"
                                           FontSize="12" Foreground="#8A8F98" TextWrapping="Wrap" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWorkbooks}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Workbooks}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <Border Background="#F1F3F6" Padding="8,5" CornerRadius="3">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#3B4252"
                                                               Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FilePath}" />
                                                </Border>
                                                <TextBlock FontSize="11" Foreground="#C0392B" TextWrapping="Wrap"
                                                           Margin="8,4,0,0" Text="{Binding UnavailableReason}"
                                                           Visibility="{Binding HasUnavailableReason, Converter={StaticResource BoolToVis}}" />
                                                <ItemsControl ItemsSource="{Binding Sheets}" Margin="8,2,0,0"
                                                              Visibility="{Binding CanSelect, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Margin="0,3,0,3" FontSize="12"
                                                                      VerticalContentAlignment="Center"
                                                                      Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 転記プレビュー -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="転記プレビュー"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="14,10,14,6" />

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="14,10">
                            <StackPanel>
                                <Button Content="転記したファイルを作成" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ExecuteCommand}" />
                                <TextBlock FontSize="11" Foreground="#8A8F98" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="元のファイルと同じフォルダーに、別名の .xlsx を作成します。データ元・元のファイル・既存ファイルは変更しません。" />
                                <Border BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FDF2F2" />
                                            <Setter Property="BorderBrush" Value="#E5C0C0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastRunSucceeded}" Value="True">
                                                    <Setter Property="Background" Value="#F1F7F2" />
                                                    <Setter Property="BorderBrush" Value="#BFD9C4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding ResultText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#A03030" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastRunSucceeded}" Value="True">
                                                        <Setter Property="Foreground" Value="#1F6B3A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Top" Margin="14,0,14,0">
                            <TextBlock FontSize="12" Foreground="#5B6472" TextWrapping="Wrap"
                                       Text="{Binding StatusText}" />

                            <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                <Border Background="#F7F8FA" BorderBrush="#E2E5EA" BorderThickness="1"
                                        CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="対象" Width="42" FontSize="11" Foreground="#8A8F98" />
                                            <TextBlock FontSize="12" Foreground="#2E3440"
                                                       Text="{Binding TargetSummaryText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="出力" Width="42" FontSize="11" Foreground="#8A8F98" />
                                            <TextBlock FontSize="12" Foreground="#2E3440" TextWrapping="Wrap"
                                                       Text="{Binding PlannedChangesText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="確認" Width="42" FontSize="11" Foreground="#8A8F98" />
                                            <TextBlock FontSize="12" Foreground="#2E3440"
                                                       Text="{Binding IssueSummaryText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="確認事項" Style="{StaticResource SectionTitle}" />
                                <TextBlock FontSize="12" Foreground="#1F8A4C"
                                           Text="✅ 実行を妨げる問題はありません。"
                                           Visibility="{Binding HasNoIssues, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 件数が多くなるため、確認事項と転記内容は仮想化された一覧で表示する。 -->
                        <Grid Margin="14,6,14,10"
                              Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MaxHeight="150" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" ItemsSource="{Binding Issues}"
                                      Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserResizeRows="False"
                                      HeadersVisibility="None" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E9EBEF" BorderBrush="#E2E5EA"
                                      Background="White" RowBackground="White" FontSize="11"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="20" Binding="{Binding Glyph}" />
                                    <DataGridTextColumn Width="110" Binding="{Binding Location}" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Message}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="1" Text="転記内容" Style="{StaticResource SectionTitle}" />

                            <DataGrid Grid.Row="2" ItemsSource="{Binding Targets}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserResizeRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E9EBEF" BorderBrush="#E2E5EA"
                                      Background="White" RowBackground="White" FontSize="11"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="20" Binding="{Binding Glyph}" />
                                    <DataGridTextColumn Header="ファイル" Width="100"
                                                        Binding="{Binding FileName}" />
                                    <DataGridTextColumn Header="シート" Width="70"
                                                        Binding="{Binding SheetName}" />
                                    <DataGridTextColumn Header="セル" Width="48"
                                                        Binding="{Binding CellReference}" />
                                    <DataGridTextColumn Header="現在" Width="80"
                                                        Binding="{Binding CurrentValueDisplay}" />
                                    <DataGridTextColumn Header="転記後" Width="*"
                                                        Binding="{Binding NewValueDisplay}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
            </DockPanel>
        </TabItem>

        <TabItem Header="6. 表を突合して更新">
            <DockPanel Margin="0,12,0,0" DataContext="{Binding TableUpdate}">
            <ContentControl DockPanel.Dock="Top" Content="{Binding Recipes}"
                            ContentTemplate="{StaticResource RecipeAreaTemplate}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*" MinWidth="440" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="7*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- データ元と転記先の表 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="2 つの表をキーで突合する"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="12,10,12,2" />
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="商品コードなどのキーが同じ行を探し、既存の行の指定した列だけを更新します。行の追加・削除はしません。元のファイルは変更せず、同じフォルダーに別名で保存します。"
                                   FontSize="11" Foreground="#8A8F98" Margin="12,0,12,8" />

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="出力名" FontSize="12" Foreground="#5B6472"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Height="24" FontSize="12"
                                         VerticalContentAlignment="Center"
                                         ToolTip="元のファイル名の後ろに付ける文字"
                                         Text="{Binding OutputSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="プレビューを更新" Margin="10,0,0,0" Padding="14,5"
                                        Command="{Binding RefreshPreviewCommand}" />
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,0,12,0">
                            <StackPanel>
                                <!-- A. データ元 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="60" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="データ元を選ぶ" Padding="10,4" FontSize="12"
                                            Command="{Binding SelectSourceCommand}" />
                                    <TextBlock Grid.Column="1" FontSize="12" Foreground="#2E3440"
                                               VerticalAlignment="Center" Margin="8,0,8,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding SourceFileNameDisplay}" />
                                    <Button Grid.Column="2" Content="項目を読み込む" Padding="10,4" FontSize="12"
                                            Command="{Binding LoadSourceColumnsCommand}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="60" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="シート" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1" Height="24" FontSize="12"
                                              IsEnabled="{Binding IsSheetSelectionEnabled}"
                                              ItemsSource="{Binding SourceSheetNames}"
                                              SelectedItem="{Binding SourceSheetName, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="項目名の行" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="10,0,6,0" />
                                    <TextBox Grid.Column="3" Height="24" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding SourceHeaderRowText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="4" Text="キー" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="10,0,6,0" />
                                    <ComboBox Grid.Column="5" Height="24" FontSize="12"
                                              ItemsSource="{Binding SourceColumns}"
                                              SelectedItem="{Binding SourceKeyColumn, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock FontSize="11" Foreground="#5B6472" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="{Binding SourceInfoText}"
                                           Visibility="{Binding HasSourceInfo, Converter={StaticResource BoolToVis}}" />

                                <!-- B. 転記先の表 -->
                                <TextBlock Text="転記先の表" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="「1. 解析結果」タブで Excel ファイルを追加すると、ここに表示されます。"
                                           FontSize="12" Foreground="#8A8F98" TextWrapping="Wrap" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWorkbooks}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Workbooks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <Border Background="#F1F3F6" Padding="8,5" CornerRadius="3">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#3B4252"
                                                               Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FilePath}" />
                                                </Border>
                                                <TextBlock FontSize="11" Foreground="#C0392B" TextWrapping="Wrap"
                                                           Margin="8,4,0,0" Text="{Binding UnavailableReason}"
                                                           Visibility="{Binding HasUnavailableReason, Converter={StaticResource BoolToVis}}" />
                                                <ItemsControl ItemsSource="{Binding Sheets}" Margin="8,2,0,0"
                                                              Visibility="{Binding CanSelect, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Margin="0,3,0,3" FontSize="12"
                                                                      VerticalContentAlignment="Center"
                                                                      Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="基準シート" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               ToolTip="転記先の項目名を読むシート" />
                                    <ComboBox Grid.Column="1" Height="24" FontSize="12"
                                              ItemsSource="{Binding ReferenceSheetChoices}"
                                              SelectedItem="{Binding ReferenceSheetDisplay, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="項目名の行" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="10,0,6,0" />
                                    <TextBox Grid.Column="3" Height="24" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding TargetHeaderRowText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="80" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="転記先の項目を読み込む" Padding="10,4" FontSize="12"
                                            Command="{Binding LoadTargetColumnsCommand}" />
                                    <TextBlock Grid.Column="2" Text="転記先のキー" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="10,0,6,0" />
                                    <ComboBox Grid.Column="3" Height="24" FontSize="12"
                                              ItemsSource="{Binding TargetColumns}"
                                              SelectedItem="{Binding TargetKeyColumn, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock FontSize="11" Foreground="#8A8F98" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="キーは文字として完全に一致する行だけを対応付けます(大文字小文字・前後の空白も区別します)。" />

                                <!-- C. 対応付け -->
                                <DockPanel Margin="0,14,0,0">
                                    <TextBlock Text="更新する列" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#3B4252" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="行を追加" Padding="10,3" FontSize="11"
                                                Command="{Binding AddMappingCommand}" />
                                        <Button Content="選択行を削除" Padding="10,3" FontSize="11" Margin="6,0,0,0"
                                                Command="{Binding RemoveMappingCommand}" />
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding Mappings}"
                                          SelectedItem="{Binding SelectedMapping, Mode=TwoWay}"
                                          Height="112" Margin="0,6,0,10"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" CanUserResizeRows="False"
                                          CanUserSortColumns="False" CanUserReorderColumns="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E9EBEF" BorderBrush="#D8DCE3"
                                          Background="White" RowBackground="White" RowHeight="27"
                                          FontSize="12" SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="IsSelected" Value="True" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="データ元の項目" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox FontSize="12" Margin="2,1"
                                                              VerticalContentAlignment="Center"
                                                              ItemsSource="{Binding SourceColumns}"
                                                              SelectedItem="{Binding SourceColumn, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="転記先の項目" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox FontSize="12" Margin="2,1"
                                                              VerticalContentAlignment="Center"
                                                              ItemsSource="{Binding TargetColumns}"
                                                              SelectedItem="{Binding TargetColumn, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="種類" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox FontSize="12" Margin="2,1"
                                                              VerticalContentAlignment="Center"
                                                              ItemsSource="{x:Static vm:TableColumnMappingRowViewModel.KindOptions}"
                                                              SelectedItem="{Binding KindDisplay, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 更新プレビュー -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="更新プレビュー"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="14,10,14,6" />

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="14,10">
                            <StackPanel>
                                <Button Content="更新したファイルを作成" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ExecuteCommand}" />
                                <TextBlock FontSize="11" Foreground="#8A8F98" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="元のファイルと同じフォルダーに、別名の .xlsx を作成します。データ元・元のファイル・既存ファイルは変更しません。" />
                                <Border BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FDF2F2" />
                                            <Setter Property="BorderBrush" Value="#E5C0C0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastRunSucceeded}" Value="True">
                                                    <Setter Property="Background" Value="#F1F7F2" />
                                                    <Setter Property="BorderBrush" Value="#BFD9C4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding ResultText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#A03030" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastRunSucceeded}" Value="True">
                                                        <Setter Property="Foreground" Value="#1F6B3A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Top" Margin="14,0,14,0">
                            <TextBlock FontSize="12" Foreground="#5B6472" TextWrapping="Wrap"
                                       Text="{Binding StatusText}" />

                            <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                <Border Background="#F7F8FA" BorderBrush="#E2E5EA" BorderThickness="1"
                                        CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="突合" Width="42" FontSize="11" Foreground="#8A8F98" />
                                            <TextBlock FontSize="12" Foreground="#2E3440" TextWrapping="Wrap"
                                                       Text="{Binding MatchSummaryText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="出力" Width="42" FontSize="11" Foreground="#8A8F98" />
                                            <TextBlock FontSize="12" Foreground="#2E3440" TextWrapping="Wrap"
                                                       Text="{Binding PlannedChangesText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="確認" Width="42" FontSize="11" Foreground="#8A8F98" />
                                            <TextBlock FontSize="12" Foreground="#2E3440"
                                                       Text="{Binding IssueSummaryText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="確認事項" Style="{StaticResource SectionTitle}" />
                                <TextBlock FontSize="12" Foreground="#1F8A4C"
                                           Text="✅ 実行を妨げる問題はありません。"
                                           Visibility="{Binding HasNoIssues, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 件数が多くなるため、確認事項と更新内容は仮想化された一覧で表示する。 -->
                        <Grid Margin="14,6,14,10"
                              Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MaxHeight="150" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="80" />
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" ItemsSource="{Binding Issues}"
                                      Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserResizeRows="False"
                                      HeadersVisibility="None" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E9EBEF" BorderBrush="#E2E5EA"
                                      Background="White" RowBackground="White" FontSize="11"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="20" Binding="{Binding Glyph}" />
                                    <DataGridTextColumn Width="110" Binding="{Binding Location}" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Message}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="1" Text="更新内容" Style="{StaticResource SectionTitle}" />

                            <DataGrid Grid.Row="2" ItemsSource="{Binding Targets}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserResizeRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E9EBEF" BorderBrush="#E2E5EA"
                                      Background="White" RowBackground="White" FontSize="11"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="20" Binding="{Binding Glyph}" />
                                    <DataGridTextColumn Header="ファイル" Width="90"
                                                        Binding="{Binding FileName}" />
                                    <DataGridTextColumn Header="シート" Width="60"
                                                        Binding="{Binding SheetName}" />
                                    <DataGridTextColumn Header="キー" Width="70"
                                                        Binding="{Binding Provenance.Key}" />
                                    <DataGridTextColumn Header="項目" Width="70"
                                                        Binding="{Binding Provenance.TargetColumn}" />
                                    <DataGridTextColumn Header="セル" Width="48"
                                                        Binding="{Binding CellReference}" />
                                    <DataGridTextColumn Header="現在" Width="70"
                                                        Binding="{Binding CurrentValueDisplay}" />
                                    <DataGridTextColumn Header="更新後" Width="*"
                                                        Binding="{Binding NewValueDisplay}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
            </DockPanel>
        </TabItem>

        <TabItem Header="7. CSV を変換">
            <DockPanel Margin="0,12,0,0" DataContext="{Binding CsvTransform}">
            <ContentControl DockPanel.Dock="Top" Content="{Binding Recipes}"
                            ContentTemplate="{StaticResource RecipeAreaTemplate}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" MinWidth="440" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="8*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!-- データ元と出力する項目 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="出力する CSV の項目を決める"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="12,10,12,2" />
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="別のシステムで使う項目名・並び順の CSV を作ります。元のファイルは変更しません。"
                                   FontSize="11" Foreground="#8A8F98" Margin="12,0,12,6" />

                        <!-- 出力設定。下に固定して、項目一覧が伸び縮みするようにする。 -->
                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="12,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="80" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="文字コード" FontSize="12"
                                               Foreground="#5B6472" VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1" Height="24" FontSize="12"
                                              VerticalContentAlignment="Center"
                                              ToolTip="Windows の Excel で開くなら UTF-8(BOM あり)が安全です"
                                              ItemsSource="{x:Static vm:CsvTransformViewModel.EncodingOptions}"
                                              SelectedItem="{Binding EncodingDisplay, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="引用符" FontSize="12"
                                               Foreground="#5B6472" VerticalAlignment="Center"
                                               Margin="12,0,6,0" />
                                    <ComboBox Grid.Column="3" Height="24" FontSize="12"
                                              VerticalContentAlignment="Center"
                                              ToolTip="「すべての項目」を選ぶと、全項目をダブルクォートで囲みます"
                                              ItemsSource="{x:Static vm:CsvTransformViewModel.QuoteOptions}"
                                              SelectedItem="{Binding QuoteDisplay, Mode=TwoWay}" />
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="出力名" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" Height="24" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             ToolTip="元のファイル名の後ろに付ける文字"
                                             Text="{Binding OutputSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="プレビューを更新" Margin="10,0,0,0" Padding="14,4"
                                            Command="{Binding RefreshPreviewCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 高さが足りないときは、この範囲だけをスクロールさせる。 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <DockPanel MinHeight="250" Margin="12,0,12,10">

                        <!-- A. データ元 -->
                        <StackPanel DockPanel.Dock="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="データ元を選ぶ" Padding="10,4" FontSize="12"
                                            Command="{Binding SelectSourceCommand}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SourceFileNameDisplay}"
                                               FontSize="12" Foreground="#3B4252" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="8,0,8,0" />
                                    <Button Grid.Column="2" Content="項目を読み込む" Padding="10,4" FontSize="12"
                                            Command="{Binding LoadColumnsCommand}" />
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="シート" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1" Height="24" FontSize="12"
                                              VerticalContentAlignment="Center"
                                              IsEnabled="{Binding IsSheetSelectionEnabled}"
                                              ItemsSource="{Binding SourceSheetNames}"
                                              SelectedItem="{Binding SourceSheetName, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="項目名の行" FontSize="12" Foreground="#5B6472"
                                               VerticalAlignment="Center" Margin="12,0,6,0" />
                                    <TextBox Grid.Column="3" Height="24" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding HeaderRowText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                            <TextBlock Text="{Binding SourceInfoText}" FontSize="11" Foreground="#8A8F98"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasSourceInfo, Converter={StaticResource BoolToVis}}" />

                            <!-- B. 出力する項目 -->
                            <DockPanel Margin="0,10,0,4">
                                    <TextBlock Text="出力する項目" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#3B4252" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="元の項目をすべて追加" Padding="8,3" FontSize="11"
                                                ToolTip="データ元の項目を、同じ名前・同じ並びで追加します"
                                                Command="{Binding AddAllSourceColumnsCommand}" />
                                        <Button Content="行を追加" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                                Command="{Binding AddColumnCommand}" />
                                        <Button Content="削除" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                                Command="{Binding RemoveColumnCommand}" />
                                        <Button Content="↑" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                                ToolTip="選んだ項目を 1 つ前へ" Command="{Binding MoveUpCommand}" />
                                        <Button Content="↓" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                                ToolTip="選んだ項目を 1 つ後ろへ" Command="{Binding MoveDownCommand}" />
                                    </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Columns}"
                                  SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                  MinHeight="110"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" CanUserResizeRows="False"
                                          CanUserSortColumns="False" CanUserReorderColumns="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E9EBEF" BorderBrush="#D8DCE3"
                                          Background="White" RowBackground="White" RowHeight="27"
                                          FontSize="12" SelectionMode="Single" SelectionUnit="FullRow"
                                          EnableRowVirtualization="True">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="IsSelected" Value="True" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="出力する項目名" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox FontSize="12" BorderThickness="0" Background="Transparent"
                                                             VerticalContentAlignment="Center" Margin="2,0"
                                                             Text="{Binding OutputName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="入れる内容" Width="86">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox FontSize="12" Margin="2,1"
                                                              VerticalContentAlignment="Center"
                                                              ItemsSource="{x:Static vm:CsvOutputColumnRowViewModel.KindOptions}"
                                                              SelectedItem="{Binding KindDisplay, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="元の項目 / 固定値" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <ComboBox FontSize="12" Margin="2,1"
                                                                  VerticalContentAlignment="Center"
                                                                  Visibility="{Binding IsSourceColumn, Converter={StaticResource BoolToVis}}"
                                                                  ItemsSource="{Binding SourceColumns}"
                                                                  SelectedItem="{Binding SourceColumn, Mode=TwoWay}" />
                                                        <TextBox FontSize="12" BorderThickness="0" Background="Transparent"
                                                                 VerticalContentAlignment="Center" Margin="2,0"
                                                                 ToolTip="すべての行に入れる文字"
                                                                 Visibility="{Binding IsFixedText, Converter={StaticResource BoolToVis}}"
                                                                 Text="{Binding FixedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- プレビュー -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="変換プレビュー"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="12,10,12,2" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="#8A8F98" Margin="12,0,12,8" />

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <StackPanel>
                                <Button Content="CSV を作成" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ExecuteCommand}" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#8A8F98"
                                           Margin="0,6,0,0"
                                           Text="元のファイルと同じフォルダーに、新しい .csv を作ります。元のファイル・既存ファイルは変更しません。" />
                                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="11"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C0392B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastRunSucceeded}" Value="True">
                                                    <Setter Property="Foreground" Value="#1F8A4C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Grid Margin="12,0,12,10"
                              Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                    BorderThickness="1" CornerRadius="4" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding RowSummaryText}" FontSize="12"
                                               Foreground="#3B4252" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding OutputSummaryText}" FontSize="11"
                                               Foreground="#5B6472" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding IssueSummaryText}" FontSize="11"
                                               Foreground="#5B6472" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="1" Text="{Binding ColumnSummaryText}" TextWrapping="Wrap"
                                       FontSize="11" Foreground="#5B6472" Margin="0,8,0,0" />

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Issues}" Margin="0,8,0,0"
                                          Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                       Style="{StaticResource MergeIssueGlyphText}"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                       FontSize="11" Foreground="#3B4252" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Grid.Row="3" Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="作られる CSV(先頭のみ)"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#3B4252"
                                           Margin="0,0,0,4" />
                                <DataGrid ItemsSource="{Binding SampleRows}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" CanUserResizeRows="False"
                                          CanUserSortColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E9EBEF" BorderBrush="#D8DCE3"
                                          Background="White" RowBackground="White" RowHeight="24"
                                          FontSize="11" SelectionMode="Single"
                                          EnableRowVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="行" Width="44"
                                                            Binding="{Binding RowNumber}" />
                                        <DataGridTextColumn Header="内容" Width="*"
                                                            Binding="{Binding Display}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
            </DockPanel>
        </TabItem>

        <TabItem Header="8. PDF を読み取る">
          <DockPanel Margin="0,12,0,0" DataContext="{Binding PdfRead}">
            <ContentControl DockPanel.Dock="Top" Content="{Binding Recipes}"
                            ContentTemplate="{StaticResource RecipeAreaTemplate}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*" MinWidth="380" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="10*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <!-- PDF の選択と出力の指定 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="PDF からデータを取り出す"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="12,10,12,2" />
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="文字情報を持つ PDF から、文章や表を取り出して Excel / CSV にします。元の PDF は変更しません。見た目をそのまま再現するものではありません。"
                                   FontSize="11" Foreground="#8A8F98" Margin="12,0,12,8" />

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="出力形式" FontSize="12"
                                               Foreground="#5B6472" VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1" Height="24" FontSize="12"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{x:Static vm:PdfReadViewModel.FormatOptions}"
                                              SelectedItem="{Binding FormatDisplay, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="出力名" FontSize="12"
                                               Foreground="#5B6472" VerticalAlignment="Center"
                                               Margin="12,0,6,0" />
                                    <TextBox Grid.Column="3" Height="24" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             ToolTip="元のファイル名の後ろに付ける文字"
                                             Text="{Binding OutputSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <!-- CSV を選んだときだけ出す -->
                                <Grid Margin="0,6,0,0"
                                      Visibility="{Binding IsCsv, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="80" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="文字コード" FontSize="12"
                                               Foreground="#5B6472" VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1" Height="24" FontSize="12"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{x:Static vm:PdfReadViewModel.EncodingOptions}"
                                              SelectedItem="{Binding EncodingDisplay, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="引用符" FontSize="12"
                                               Foreground="#5B6472" VerticalAlignment="Center"
                                               Margin="12,0,6,0" />
                                    <ComboBox Grid.Column="3" Height="24" FontSize="12"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{x:Static vm:PdfReadViewModel.QuoteOptions}"
                                              SelectedItem="{Binding QuoteDisplay, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12,0,12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="PDF を選ぶ" Padding="10,4" FontSize="12"
                                        Command="{Binding SelectSourceCommand}" />
                                <TextBlock Grid.Column="1" Text="{Binding SourceFileNameDisplay}"
                                           FontSize="12" Foreground="#3B4252"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="8,0,8,0" />
                                <Button Grid.Column="2" Content="PDF を解析" Padding="10,4" FontSize="12"
                                        Command="{Binding AnalyzeCommand}" />
                            </Grid>

                            <Border Background="#F7F8FA" BorderBrush="#E2E5EA" BorderThickness="1"
                                    CornerRadius="4" Padding="10,8" Margin="0,10,0,0"
                                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="判定" FontSize="11"
                                                   Foreground="#8A8F98" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding KindText}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#3B4252"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="{Binding SummaryText}" FontSize="11"
                                               Foreground="#5B6472" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding OutputSummaryText}" FontSize="11"
                                               Foreground="#5B6472" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding IssueSummaryText}" FontSize="11"
                                               Foreground="#5B6472" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- スキャン PDF: OCR で読み取る導線 -->
                            <Border Background="#FFF8E8" BorderBrush="#E8D8A8" BorderThickness="1"
                                    CornerRadius="4" Padding="10,8" Margin="0,10,0,0"
                                    Visibility="{Binding NeedsOcr, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="スキャンされたページの読み取り" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#3B4252" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#5B6472"
                                               Margin="0,4,0,0"
                                               Text="画像のページは OCR で読み取ります。読み取った内容は必ず確認してから出力します。" />
                                    <TextBlock Text="{Binding OcrPackText}" TextWrapping="Wrap"
                                               FontSize="11" Foreground="#8A8F98" Margin="0,4,0,0" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="読み取り方" FontSize="11"
                                                   Foreground="#5B6472" VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <ComboBox Grid.Column="1" Height="24" FontSize="11"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{x:Static vm:PdfReadViewModel.ReadModeOptions}"
                                                  SelectedItem="{Binding ReadModeDisplay, Mode=TwoWay}" />
                                    </Grid>

                                    <!-- 同じ様式の帳票として読むときの項目 -->
                                    <Border Background="#FFFFFF" BorderBrush="#E2E5EA" BorderThickness="1"
                                            CornerRadius="3" Padding="8,6" Margin="0,8,0,0"
                                            Visibility="{Binding IsFixedForm, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TemplateSummaryText}" FontSize="11"
                                                       Foreground="#3B4252" TextWrapping="Wrap" />
                                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#8A8F98"
                                                       Margin="0,4,0,0"
                                                       Text="1 ページ目を読み取ると、「項目名: 値」の形の行から候補を作ります。名前と種類を直してから、もう一度読み取ってください。" />
                                            <DataGrid ItemsSource="{Binding TemplateFields}" Height="104"
                                                      Margin="0,6,0,0"
                                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                                      CanUserDeleteRows="True" CanUserResizeRows="False"
                                                      CanUserSortColumns="False"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      HorizontalGridLinesBrush="#E9EBEF"
                                                      BorderBrush="#D8DCE3" Background="White"
                                                      RowBackground="White" RowHeight="22" FontSize="11">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="項目名" Width="*"
                                                                        Binding="{Binding Name, Mode=TwoWay,
                                                                            UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridComboBoxColumn Header="種類" Width="96"
                                                                            SelectedItemBinding="{Binding Kind, Mode=TwoWay}"
                                                                            ItemsSource="{x:Static vm:FormFieldRow.KindOptions}" />
                                                    <DataGridCheckBoxColumn Header="必須" Width="42"
                                                                            Binding="{Binding IsRequired, Mode=TwoWay}" />
                                                    <DataGridTextColumn Header="読み取る場所" Width="130"
                                                                        IsReadOnly="True"
                                                                        Binding="{Binding AreaText}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="OCR で読み取る" Padding="10,4" FontSize="12"
                                                Command="{Binding RunOcrCommand}" />
                                        <Button Content="中止" Padding="10,4" FontSize="12" Margin="8,0,0,0"
                                                Command="{Binding CancelOcrCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                               Foreground="#3B4252" Margin="0,6,0,0"
                                               Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Issues}" Margin="0,10,0,0"
                                          Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                       Style="{StaticResource MergeIssueGlyphText}"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                       FontSize="11" Foreground="#3B4252"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- プレビューと作成 -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D8DCE3"
                        BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="取り出した内容"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B4252"
                                   Margin="12,10,12,2" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="#8A8F98" Margin="12,0,12,8" />

                        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <StackPanel>
                                <Button Content="ファイルを作成" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ExecuteCommand}" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#8A8F98"
                                           Margin="0,6,0,0"
                                           Text="元の PDF と同じフォルダーに、新しいファイルを作ります。元の PDF・既存ファイルは変更しません。" />
                                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="11"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C0392B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastRunSucceeded}" Value="True">
                                                    <Setter Property="Foreground" Value="#1F8A4C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <!-- 確認中でないとき: 取り出した内容だけ -->
                            <DataGrid ItemsSource="{Binding PreviewRows}" Margin="12,0,12,10"
                                      Visibility="{Binding HasNoReading, Converter={StaticResource BoolToVis}}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" CanUserResizeRows="False"
                                      CanUserSortColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E9EBEF" BorderBrush="#D8DCE3"
                                      Background="White" RowBackground="White" RowHeight="24"
                                      FontSize="11" SelectionMode="Single"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding DataContext.FirstColumnHeader,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Width="64" Binding="{Binding First}" />
                                    <DataGridTextColumn Header="{Binding DataContext.SecondColumnHeader,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Width="64" Binding="{Binding Second}" />
                                    <DataGridTextColumn Header="{Binding DataContext.TextColumnHeader,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Width="*" Binding="{Binding Text}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 確認中: 元のページ画像を見ながら 1 件ずつ確認する -->
                            <Grid Margin="12,0,12,10" KeyDown="PdfReview_KeyDown"
                                  Visibility="{Binding HasReading, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2*" MinHeight="90" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1*" MinHeight="64" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding ReviewSummaryText}" FontSize="11"
                                           Foreground="#3B4252" TextWrapping="Wrap" />

                                <!-- ページ送りと拡大縮小 -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,4">
                                    <Button Content="&#x25C0;" Width="26" Padding="0,2" FontSize="11"
                                            ToolTip="前のページ"
                                            Command="{Binding PreviousPageCommand}" />
                                    <TextBlock Text="{Binding PageText}" FontSize="11" Foreground="#3B4252"
                                               VerticalAlignment="Center" Margin="6,0,6,0" MinWidth="76"
                                               TextAlignment="Center" />
                                    <Button Content="&#x25B6;" Width="26" Padding="0,2" FontSize="11"
                                            ToolTip="次のページ"
                                            Command="{Binding NextPageCommand}" />
                                    <Button Content="&#xFF0D;" Width="26" Padding="0,2" FontSize="11"
                                            Margin="12,0,0,0"
                                            ToolTip="縮小" Command="{Binding ZoomOutCommand}" />
                                    <TextBlock Text="{Binding ZoomText}" FontSize="11" Foreground="#3B4252"
                                               VerticalAlignment="Center" Margin="6,0,6,0" MinWidth="42"
                                               TextAlignment="Center" />
                                    <Button Content="&#xFF0B;" Width="26" Padding="0,2" FontSize="11"
                                            ToolTip="拡大" Command="{Binding ZoomInCommand}" />
                                    <Button Content="100%" Padding="8,2" FontSize="11" Margin="8,0,0,0"
                                            Command="{Binding ActualSizeCommand}" />
                                    <Button Content="全体" Padding="8,2" FontSize="11" Margin="4,0,0,0"
                                            ToolTip="ページ全体が入る大きさ"
                                            Command="{Binding FitCommand}" />
                                    <CheckBox Content="自動確定も表示" FontSize="11" Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding ShowAutoAccepted, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- 元のページ画像 + 読み取り位置の強調 -->
                                <Border Grid.Row="2" BorderBrush="#D8DCE3" BorderThickness="1"
                                        Background="#F0F1F4">
                                    <ScrollViewer x:Name="PdfPageScroll"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  SizeChanged="PdfPageScroll_SizeChanged">
                                            <Grid x:Name="PdfPageSurface"
                                              Width="{Binding ImageDisplayWidth}"
                                              Height="{Binding ImageDisplayHeight}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding PageImageSource}"
                                                   Stretch="Fill" SnapsToDevicePixels="True" />
                                            <Canvas>
                                                <Rectangle Canvas.Left="{Binding HighlightLeft}"
                                                           Canvas.Top="{Binding HighlightTop}"
                                                           Width="{Binding HighlightWidth}"
                                                           Height="{Binding HighlightHeight}"
                                                           Stroke="#D64545" StrokeThickness="2"
                                                           Fill="#22D64545"
                                                           Visibility="{Binding HasHighlight,
                                                               Converter={StaticResource BoolToVis}}" />
                                            </Canvas>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>

                                <!-- 選んでいる項目の詳細と、確認して次へ -->
                                <Border Grid.Row="3" Background="#F7F8FA" BorderBrush="#E2E5EA"
                                        BorderThickness="1" Padding="8,6" Margin="0,6,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SelectedPositionText}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#3B4252" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedEngineText}"
                                                       FontSize="11" Foreground="#8A8F98"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <!-- なぜ確認が要るのか。自信が高くても形が怪しいときはここに出る。 -->
                                        <TextBlock Text="{Binding SelectedReasonText}" FontSize="11"
                                                   Foreground="#8A5A00" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasSelectedReason,
                                                       Converter={StaticResource BoolToVis}}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="修正して確認 &#x2192; 次へ" Padding="10,4" FontSize="11"
                                                    Command="{Binding ConfirmAndNextCommand}" />
                                            <Button Content="元のままで確認 &#x2192; 次へ" Padding="10,4" FontSize="11"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding ConfirmOriginalAndNextCommand}" />
                                            <Button Content="前の要確認" Padding="8,4" FontSize="11"
                                                    Margin="16,0,0,0"
                                                    Command="{Binding PreviousReviewCommand}" />
                                            <Button Content="次の要確認" Padding="8,4" FontSize="11"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding NextReviewCommand}" />
                                            <TextBlock FontSize="10" Foreground="#8A8F98"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="Enter: 修正して確認して次へ / Ctrl+Enter: 元のままで確認して次へ / Esc: 修正を取り消す / F3: 次の要確認"
                                                       Text="Enter 確認 / Ctrl+Enter 元のまま / Esc 取消 / F3 次" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <DataGrid Grid.Row="4" ItemsSource="{Binding ReviewItems}"
                                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" CanUserResizeRows="False"
                                          CanUserSortColumns="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E9EBEF" BorderBrush="#D8DCE3"
                                          Background="White" RowBackground="White" RowHeight="24"
                                          FontSize="11" SelectionMode="Single"
                                          EnableRowVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                    <Setter Property="Background" Value="#FFF6F5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ページ / 行" Width="72" IsReadOnly="True"
                                                            Binding="{Binding PositionText}" />
                                        <DataGridTextColumn Header="読み取った内容" Width="*" IsReadOnly="True"
                                                            Binding="{Binding OriginalText}" />
                                        <DataGridTextColumn Header="自信" Width="46" IsReadOnly="True"
                                                            Binding="{Binding ConfidenceText}" />
                                        <DataGridTextColumn Header="状態" Width="64" IsReadOnly="True"
                                                            Binding="{Binding StatusText}" />
                                        <DataGridTextColumn Header="修正値" Width="*"
                                                            Binding="{Binding EditedText, Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
          </DockPanel>
        </TabItem>

        </TabControl>
    </DockPanel>
</Window>
