<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ViewModel(基準シートの選択状態など)も検証するため WPF 参照が必要。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- WPF 参照時は暗黙 using から System.IO が外れる(System.Windows.Shapes.Path との衝突回避)。
         このプロジェクトは図形を使わないので、Shapes を外して System.IO を戻す。 -->
    <Using Remove="System.Windows.Shapes" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExcelBatchTool.Core\ExcelBatchTool.Core.csproj" />
    <ProjectReference Include="..\..\src\ExcelBatchTool.App\ExcelBatchTool.App.csproj" />
  </ItemGroup>

</Project>
